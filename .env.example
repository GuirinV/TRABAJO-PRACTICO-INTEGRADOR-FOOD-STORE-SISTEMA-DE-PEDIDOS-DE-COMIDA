# Backend. SQLite funciona sin instalar PostgreSQL en desarrollo local.
DATABASE_URL=sqlite:///./food_store.db
SECRET_KEY=replace-this-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
APP_NAME=Food Store API
API_V1_PREFIX=/api/v1

# Credenciales del admin creado por: python -m app.seed
SEED_ADMIN_NAME=Food Store Admin
SEED_ADMIN_EMAIL=admin@foodstore.local
SEED_ADMIN_PASSWORD=Admin1234!

# Frontend (crear frontend/.env.local para cambiar el valor)
VITE_API_URL=http://localhost:8000/api/v1
